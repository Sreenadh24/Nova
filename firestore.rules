rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.role == 'customer'
        && request.resource.data.email == request.auth.token.email;
      allow update: if isAdmin()
        || (isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'phone', 'photoUrl', 'updatedAt']));
      allow delete: if isAdmin();
    }

    match /carts/{uid} {
      allow read, create, update, delete: if isOwner(uid);
    }

    match /addresses/{uid}/items/{addressId} {
      allow read, create, update, delete: if isOwner(uid);
    }

    match /orders/{orderId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      // Order creation and payment verification must be performed by a trusted
      // backend that recalculates prices, discounts, tax, and stock.
      allow create, delete: if false;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt']);
    }
  }
}
